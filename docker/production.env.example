# Environment of the server. Copy this file to `.env.production` next to compose.yaml
# (cp docker/production.env.example .env.production) and fill in the two lines marked
# REQUIRED. `.env.production` never goes into git: it is ignored.

APP_NAME="Ruta Laravel"
APP_ENV=production
APP_DEBUG=false

# REQUIRED. A secret key, created once and kept forever: changing it signs everybody out
# and makes anything encrypted unreadable. Create it with:
#   docker compose run --rm --no-deps --entrypoint php app artisan key:generate --show
APP_KEY=

# REQUIRED. The address people type, without "https://". With a domain of your own, use it
# (ruta.example.com). Without one, a name made from the server's IP works: for the IP
# 203.0.113.10 it is 203-0-113-10.sslip.io (replace the dots with dashes).
# Caddy gets the HTTPS certificate for it by itself.
SERVER_NAME=203-0-113-10.sslip.io
APP_URL=https://203-0-113-10.sslip.io

# Nobody can create an account from the login page. Make yours on the server with:
#   docker compose exec app php artisan user:create
REGISTRATION_ENABLED=false

# The browser only sends the session cookie over HTTPS.
SESSION_SECURE_COOKIE=true

# Everything below is already the default of the image. It is here to show what exists.
# The SQLite file lives on the volume, so it survives a new version of the app.
DB_CONNECTION=sqlite
DB_DATABASE=/data/database.sqlite
SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=sync
LOG_CHANNEL=stderr
LOG_LEVEL=warning

# Mail is not used: accounts are created by hand. Password reset by email would need a
# mail server configured here.
MAIL_MAILER=log
